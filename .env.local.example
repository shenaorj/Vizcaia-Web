# Vizcaia-Web — environment variables example.
# Copia a `.env.local` y rellena con valores reales.
# `.env.local` está en .gitignore — nunca commitear secrets reales.
#
# En producción, estas variables se configuran en Coolify → Environment Variables.

# ─── SMTP (Gmail App Password de vizcaia.technologies@gmail.com) ──────
# El mismo App Password ya configurado para Outline.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=vizcaia.technologies@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# ─── Outline (para crear leads automáticamente) ───────────────────────
# Token con scope `documents.create`, generado en https://outline.vizcaia.com/settings/api
OUTLINE_API_TOKEN=ol_api_xxxxxxxxxxxxxxxxxxxxxxxxxx
# UUID de la colección "Leads" en Outline (crear en T19).
OUTLINE_LEADS_COLLECTION_ID=00000000-0000-0000-0000-000000000000

# ─── Site URL (para canonical, OG image, sitemap) ─────────────────────
NEXT_PUBLIC_SITE_URL=https://vizcaia.com

# ─── Cloudflare Web Analytics (cookieless, gratis) ────────────────────
# Obtener en https://dash.cloudflare.com → Web Analytics → Add site.
# Solo activo en producción (NODE_ENV=production). Si no se setea, no carga script.
NEXT_PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
